    "owner": "lenticule-science",
    "kind": "actor",
    "actor": "urn:ame:attention-allocation-readout",
    "operations": [
      "invoke-service",
      "solicit-service"
    ],
    "capabilities": [
      {
        "capability": "attention-allocation-readout",
        "faces": [
          "invoke-service",
          "solicit-service"
        ]
      }
    ],
    "package": "@lenticule-science/attention-allocation-readout-service"
  }
